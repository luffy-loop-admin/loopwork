# ---------- Supabase (Project Settings -> API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET. Never share or commit. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Google service account (see README step 3) ----------
GOOGLE_SERVICE_ACCOUNT_EMAIL=portal-reader@your-project.iam.gserviceaccount.com
# Paste the "private_key" value from the JSON file, in double quotes, keeping the \n characters.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------- Serper.dev (indexing check) ----------
SERPER_API_KEY=your-serper-api-key

# ---------- Cron protection ----------
# Any long random string (e.g. 40+ characters). Vercel sends it automatically to the cron jobs.
CRON_SECRET=change-me-to-a-long-random-string

# ---------- Only used by `npm run seed:admin` on your own computer ----------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=a-long-strong-password
